{
  "uid": "expenseflow-overview",
  "title": "ExpenseFlow overview",
  "tags": ["expenseflow"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1d", "to": "now" },
  "timepicker": {
    "quick_ranges": [
      { "display": "1D", "from": "now-1d", "to": "now" },
      { "display": "7D", "from": "now-7d", "to": "now" },
      { "display": "1M", "from": "now-30d", "to": "now" }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Services up",
      "description": "1 = Prometheus can scrape the service. Alert: DOWN for 1 min.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "up{job=~\"backend|mock-bank\"}", "legendFormat": "{{job}}" } ],
      "fieldConfig": { "defaults": {
        "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ],
        "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] }
    },
    {
      "id": 2, "type": "timeseries", "title": "Request rate (req/s)",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{application=\"expenseflow\"}[$__rate_interval]))", "legendFormat": "all" } ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 3, "type": "timeseries", "title": "Error rate (5xx, %)",
      "description": "Alert: > 5% for 5 min.",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "100 * sum(rate(http_server_requests_seconds_count{application=\"expenseflow\",status=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{application=\"expenseflow\"}[$__rate_interval]))", "legendFormat": "5xx %" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] }
    },
    {
      "id": 4, "type": "timeseries", "title": "API latency p95 (s)",
      "description": "Needs percentiles-histogram for http.server.requests on the backend (task filed for L2).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"expenseflow\"}[$__rate_interval])))", "legendFormat": "p95" } ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] }
    },
    {
      "id": 5, "type": "timeseries", "title": "Page load latency p95 (s)",
      "description": "From POST /api/telemetry/page-load; metric page_load_seconds (task filed for L2).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(page_load_seconds_bucket[$__rate_interval])))", "legendFormat": "p95" } ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] }
    },
    {
      "id": 6, "type": "timeseries", "title": "Approval queue size by level",
      "description": "approval_queue_size{level} gauge (task filed for L2/L3). Alert: > 200 for 15 min.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (level) (approval_queue_size)", "legendFormat": "{{level}}" } ],
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] }
    },
    {
      "id": 7, "type": "stat", "title": "Oldest pending approval",
      "description": "approval_oldest_pending_age_seconds gauge. Alert: > 72 h.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "max(approval_oldest_pending_age_seconds)" } ],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 172800 }, { "color": "red", "value": 259200 } ] } }, "overrides": [] }
    },
    {
      "id": 8, "type": "timeseries", "title": "Bank payout files by outcome (per 5 min)",
      "description": "Mock bank counter mockbank_payout_files_total.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (outcome) (increase(mockbank_payout_files_total[5m]))", "legendFormat": "{{outcome}}" } ],
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] }
    },
    {
      "id": 9, "type": "timeseries", "title": "Bank faults injected (per 5 min)",
      "description": "Mock bank counter mockbank_faults_injected_total (incident drill).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (type) (increase(mockbank_faults_injected_total[5m]))", "legendFormat": "{{type}}" } ],
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] }
    }
  ]
}
